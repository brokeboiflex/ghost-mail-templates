<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{post.title}}</title>
  <style>
    body { margin: 0; padding: 0; background: #f4f4f4; font-family: Georgia, serif; color: #1a1a1a; }
    .wrap { max-width: 640px; margin: 0 auto; background: #ffffff; }
    .header { padding: 32px 32px 16px; border-bottom: 1px solid #eee; }
    .header h1 { margin: 0; font-size: 14px; letter-spacing: 0.2em; text-transform: uppercase; color: #888; }
    .hero { width: 100%; display: block; }
    .body { padding: 32px; font-size: 17px; line-height: 1.6; }
    .body h1, .body h2, .body h3 { font-weight: 700; line-height: 1.25; }
    .body a { color: #b00020; }
    .footer { padding: 24px 32px 40px; font-size: 12px; color: #888; border-top: 1px solid #eee; }
    .footer a { color: #888; }
  </style>
</head>
<body>
  <span style="display:none;visibility:hidden;opacity:0;height:0;width:0;">{{post.excerpt}}</span>
  <div class="wrap">
    <div class="header"><h1>{{site.title}}</h1></div>
    {{#if post.feature_image}}<img class="hero" src="{{post.feature_image}}" alt="">{{/if}}
    <div class="body">
      <h1>{{post.title}}</h1>
      {{{post.html}}}
      <p style="margin-top:32px;"><a href="{{post.url}}">Czytaj na stronie &rarr;</a></p>
    </div>
    <div class="footer">
      Otrzymujesz to, bo subskrybujesz {{site.title}} jako {{member.email}}.<br>
      <a href="{{unsubscribe_url}}">Wypisz się</a> &middot; &copy; {{site.title}}
    </div>
  </div>
</body>
</html>
